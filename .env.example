NODE_ENV=development
PORT_CORE=3001
PORT_LEARNING=3002
PORT_EXERCISE=3003
PORT_WORKSPACE=3004
PORT_DOCUMENT=3005
PORT_SUBMISSION=3006
PORT_JUDGE=3007
PORT_AI=3008
PORT_REALTIME=3009
# 3012 chứ không phải 3010/3011: kong.yml định tuyến /api/v1/notifications tới cổng này.
PORT_NOTIFICATION=3012
API_PREFIX=api

# Trỏ tới database do codementor-infra dựng (docker compose ở repo đó).
DATABASE_URL=postgresql://codementor:codementor@localhost:55432/codementor?schema=public
MONGO_URI=mongodb://codementor:codementor@localhost:57017/codementor?authSource=admin
MONGO_DB=codementor

# Keycloak giữ credential và ký token. Không có secret JWT ở backend.
KEYCLOAK_ISSUER=http://localhost:8080/realms/codementor
KEYCLOAK_AUDIENCE=codementor-api
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=codementor
KEYCLOAK_USER_SERVICE_CLIENT_ID=codementor-user-service
KEYCLOAK_USER_SERVICE_CLIENT_SECRET=
# Public client whose allowed redirects include CLIENT_APP_URL/profile?tab=settings.
# Configure Realm settings > Email (SMTP) in Keycloak; SES API credentials alone do not configure it.
KEYCLOAK_EMAIL_VERIFICATION_CLIENT_ID=codementor-web

# Backend-to-backend calls. Use one random value of at least 24 characters on every service.
# Lecter đọc từ vựng chủ đề (`GET /tags`) của core-service bằng token của người dùng.
CORE_SERVICE_URL=http://localhost:3001
EXERCISE_SERVICE_URL=http://localhost:3003
JUDGE_SERVICE_URL=http://localhost:3007
WORKSPACE_SERVICE_URL=http://localhost:3004
INTERNAL_SERVICE_TOKEN=change-this-local-internal-token

KAFKA_BROKERS=localhost:9092

LOG_LEVEL=debug
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:3000

# --- judge-service (Python/FastAPI) ---
# Engine chấm. "judge0" cần isolate + cgroup v1; máy dev chạy cgroup v2 nên để "docker".
EXECUTION_ENGINE=docker
JUDGE0_URL=http://localhost:2358
# Số container chạy đồng thời trên host này. 4 an toàn cho máy dev dùng chung; benchmark trên
# máy 12 nhân cho thấy 30-50 vẫn ổn. Chỉnh theo máy, không có con số phổ quát.
DOCKER_EXECUTION_CONCURRENCY=4

# --- AWS S3 (video bài học) ---
# Cả nhóm này TUỲ CHỌN. Bỏ trống thì mọi service vẫn chạy bình thường, chỉ riêng nút
# "Tải video lên" trong studio bị tắt — giảng viên vẫn dán được URL video. Điền vào để
# bật tải lên; không cần khai báo gì thêm ở nơi khác.
#
# Trình duyệt PUT thẳng lên bucket bằng URL ký sẵn, không đi qua backend. Vì vậy bucket
# phải cho phép CORS: AllowedMethods PUT, AllowedOrigins là origin của studio giảng viên
# (mặc định http://localhost:3010), AllowedHeaders "*".
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Thư mục gốc của video trong bucket.
AWS_S3_VIDEO_PREFIX=public/videos
AWS_S3_DOCUMENT_PREFIX=public/workspace-documents
AWS_S3_IMAGE_PREFIX=public/images
# Đường ĐỌC lại. Bỏ trống = suy từ bucket + region. Điền khi có CDN đứng trước.
AWS_S3_PUBLIC_URL=
# Hạn của một URL ký sẵn, tính bằng giây.
AWS_S3_PRESIGNED_EXPIRES=900
# Chỉ dùng cho kho tương thích S3 (MinIO, R2, Spaces). AWS thật thì bỏ trống.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# SES shares AWS_REGION and the AWS SDK default credential chain with S3.
# Local: existing AWS_* credentials. EC2: instance role, no static credentials needed.
SES_ENABLED=false
SES_FROM_EMAIL=noreply@codementor.cloud
SES_FROM_NAME=CodeMentor
CLIENT_APP_URL=http://localhost:3000
REMINDER_POLL_SECONDS=60
LEARNING_INACTIVITY_DAYS=3
VIDEO_MAX_UPLOAD_MB=500
DOCUMENT_MAX_UPLOAD_MB=20
IMAGE_MAX_UPLOAD_MB=5
# Chỉ dùng khi chạy seed Workspace demo; để trống nếu không muốn đồng bộ mật khẩu Keycloak.
WORKSPACE_DEMO_PASSWORD=

# AI Tutor: backend only. Never add these credentials to NEXT_PUBLIC_*.
OPENAI_API_KEY=
# RAG / Recommendation vector
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Chat / Generate / Classification
OPENAI_CHAT_MODEL=gpt-5-nano
AI_SERVICE_URL=http://localhost:3008
AI_REQUEST_TIMEOUT_MS=90000
AI_DAILY_REQUEST_LIMIT=50
# Gợi ý testcase gọi model nhiều lần hơn hỏi đáp tài liệu; agent Lecter tiêu 5-15 lời gọi cho
# một yêu cầu. Ba bề mặt, ba bộ đếm riêng trong `ai_usage` (xem apps/ai-service/app/budget.py).
AI_SUGGEST_DAILY_LIMIT=100
AI_LECTER_DAILY_LIMIT=30
# Việc suy luận (soạn đề, viết lời giải mẫu) dùng model khác việc mẫu. Lecter phải bám một quy
# trình gọi tool 5 bước, nên tầng nano không đủ. Để trống thì rơi về OPENAI_CHAT_MODEL.
AI_MODEL_SMART=gpt-5.4-mini
