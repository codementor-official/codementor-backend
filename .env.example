NODE_ENV=development
PORT_CORE=3001
PORT_LEARNING=3002
PORT_EXERCISE=3003
PORT_WORKSPACE=3004
PORT_DOCUMENT=3005
PORT_SUBMISSION=3006
PORT_JUDGE=3007
PORT_AI=3008
PORT_REALTIME=3009
# 3012 chứ không phải 3010/3011: kong.yml định tuyến /api/v1/notifications tới cổng này.
PORT_NOTIFICATION=3012
API_PREFIX=api

# Trỏ tới database do codementor-infra dựng (docker compose ở repo đó).
DATABASE_URL=postgresql://codementor:codementor@localhost:55432/codementor?schema=public
MONGO_URI=mongodb://codementor:codementor@localhost:57017/codementor?authSource=admin
MONGO_DB=codementor

# Keycloak giữ credential và ký token. Không có secret JWT ở backend.
KEYCLOAK_ISSUER=http://localhost:8080/realms/codementor
KEYCLOAK_AUDIENCE=codementor-api
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=codementor
KEYCLOAK_USER_SERVICE_CLIENT_ID=codementor-user-service
KEYCLOAK_USER_SERVICE_CLIENT_SECRET=

KAFKA_BROKERS=localhost:9092

LOG_LEVEL=debug
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:3000

# --- judge-service (Python/FastAPI) ---
# Engine chấm. "judge0" cần isolate + cgroup v1; máy dev chạy cgroup v2 nên để "docker".
EXECUTION_ENGINE=docker
JUDGE0_URL=http://localhost:2358
# Số container chạy đồng thời trên host này. 4 an toàn cho máy dev dùng chung; benchmark trên
# máy 12 nhân cho thấy 30-50 vẫn ổn. Chỉnh theo máy, không có con số phổ quát.
DOCKER_EXECUTION_CONCURRENCY=4

# --- AWS S3 (video bài học) ---
# Cả nhóm này TUỲ CHỌN. Bỏ trống thì mọi service vẫn chạy bình thường, chỉ riêng nút
# "Tải video lên" trong studio bị tắt — giảng viên vẫn dán được URL video. Điền vào để
# bật tải lên; không cần khai báo gì thêm ở nơi khác.
#
# Trình duyệt PUT thẳng lên bucket bằng URL ký sẵn, không đi qua backend. Vì vậy bucket
# phải cho phép CORS: AllowedMethods PUT, AllowedOrigins là origin của studio giảng viên
# (mặc định http://localhost:3010), AllowedHeaders "*".
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Thư mục gốc của video trong bucket.
AWS_S3_VIDEO_PREFIX=public/videos
# Đường ĐỌC lại. Bỏ trống = suy từ bucket + region. Điền khi có CDN đứng trước.
AWS_S3_PUBLIC_URL=
# Hạn của một URL ký sẵn, tính bằng giây.
AWS_S3_PRESIGNED_EXPIRES=900
# Chỉ dùng cho kho tương thích S3 (MinIO, R2, Spaces). AWS thật thì bỏ trống.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
VIDEO_MAX_UPLOAD_MB=500
# Chỉ dùng khi chạy seed Workspace demo; để trống nếu không muốn đồng bộ mật khẩu Keycloak.
WORKSPACE_DEMO_PASSWORD=
