{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/core-service/src",
  "monorepo": true,
  "root": "apps/core-service",
  "compilerOptions": {
    "webpack": false,
    "deleteOutDir": true,
    "tsConfigPath": "apps/core-service/tsconfig.app.json"
  },
  "projects": {
    "core-service": {
      "type": "application",
      "root": "apps/core-service",
      "entryFile": "main",
      "sourceRoot": "apps/core-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/core-service/tsconfig.app.json"
      }
    },
    "learning-service": {
      "type": "application",
      "root": "apps/learning-service",
      "entryFile": "main",
      "sourceRoot": "apps/learning-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/learning-service/tsconfig.app.json"
      }
    },
    "exercise-service": {
      "type": "application",
      "root": "apps/exercise-service",
      "entryFile": "main",
      "sourceRoot": "apps/exercise-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/exercise-service/tsconfig.app.json"
      }
    },
    "workspace-service": {
      "type": "application",
      "root": "apps/workspace-service",
      "entryFile": "main",
      "sourceRoot": "apps/workspace-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/workspace-service/tsconfig.app.json"
      }
    },
    "document-service": {
      "type": "application",
      "root": "apps/document-service",
      "entryFile": "main",
      "sourceRoot": "apps/document-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/document-service/tsconfig.app.json"
      }
    },
    "submission-service": {
      "type": "application",
      "root": "apps/submission-service",
      "entryFile": "main",
      "sourceRoot": "apps/submission-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/submission-service/tsconfig.app.json"
      }
    },
    "ai-service": {
      "type": "application",
      "root": "apps/ai-service",
      "entryFile": "main",
      "sourceRoot": "apps/ai-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ai-service/tsconfig.app.json"
      }
    },
    "realtime-service": {
      "type": "application",
      "root": "apps/realtime-service",
      "entryFile": "main",
      "sourceRoot": "apps/realtime-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/realtime-service/tsconfig.app.json"
      }
    },
    "kernel": {
      "type": "library",
      "root": "libs/kernel",
      "entryFile": "index",
      "sourceRoot": "libs/kernel/src",
      "compilerOptions": {
        "tsConfigPath": "libs/kernel/tsconfig.lib.json"
      }
    },
    "platform": {
      "type": "library",
      "root": "libs/platform",
      "entryFile": "index",
      "sourceRoot": "libs/platform/src",
      "compilerOptions": {
        "tsConfigPath": "libs/platform/tsconfig.lib.json"
      }
    },
    "messaging": {
      "type": "library",
      "root": "libs/messaging",
      "entryFile": "index",
      "sourceRoot": "libs/messaging/src",
      "compilerOptions": {
        "tsConfigPath": "libs/messaging/tsconfig.lib.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "notification-service": {
      "type": "application",
