  status                exercise_status         @default(draft)
  source                exercise_source         @default(manual)
  xp_reward             Int                     @default(0)
  estimated_minutes     Int?
  time_limit_ms         Int                     @default(1000)
  memory_limit_kb       Int                     @default(262144)
  author_id             String?                 @db.Uuid
  content_ref           String?
  acceptance_rate       Decimal?                @db.Decimal(5, 2)
  solver_count          Int                     @default(0)
