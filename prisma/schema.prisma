  users_group_documents_uploader_idTousers users?                       @relation("group_documents_uploader_idTousers", fields: [uploader_id], references: [id], onUpdate: NoAction)
  group_exercises                          group_exercises[]
  workspace_document_reports               workspace_document_reports[]

  @@index([group_id, uploaded_at(sort: Desc)], map: "idx_group_documents_group")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
