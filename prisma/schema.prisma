generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model articles {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String         @unique @db.Citext
  title        String
  excerpt      String?
  takeaway     String?
  author_id    String?        @db.Uuid
  tag_id       String?        @db.Uuid
  read_minutes Int?
  status       content_status @default(draft)
  content_ref  String?
  published_at DateTime?      @db.Timestamptz(6)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  users        users?         @relation(fields: [author_id], references: [id], onUpdate: NoAction)
  tags         tags?          @relation(fields: [tag_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assignments {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id          String            @db.Uuid
  group_exercise_id String            @db.Uuid
  member_id         String            @db.Uuid
  status            assignment_status @default(notstarted)
  review_status     review_status     @default(pending)
  feedback          String?
  started_at        DateTime?         @db.Timestamptz(6)
  reviewed_by       String?           @db.Uuid
  reviewed_at       DateTime?         @db.Timestamptz(6)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @db.Timestamptz(6)
  group_exercises   group_exercises   @relation(fields: [group_id, group_exercise_id], references: [group_id, id], onDelete: Cascade, onUpdate: NoAction, map: "assignments_exercise_in_group")
  group_members     group_members     @relation(fields: [group_id, member_id], references: [group_id, id], onDelete: Cascade, onUpdate: NoAction, map: "assignments_member_in_group")
  users             users?            @relation(fields: [reviewed_by], references: [id], onUpdate: NoAction)
  submissions       submissions[]
  assignment_reminder_deliveries assignment_reminder_deliveries[]

  @@unique([group_exercise_id, member_id])
  @@index([member_id, status], map: "idx_assignments_member")
}

model assignment_reminder_deliveries {
  assignment_id String      @db.Uuid
  kind          String      @db.VarChar(20)
  sent_at       DateTime    @default(now()) @db.Timestamptz(6)
  assignments   assignments @relation(fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([assignment_id, kind], map: "pk_assignment_reminder_deliveries")
  @@index([sent_at(sort: Desc)], map: "idx_assignment_reminder_deliveries_sent")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model chapters {
  id                                             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id                                      String    @db.Uuid
  title                                          String
  description                                    String?
  position                                       Int
  is_optional                                    Boolean   @default(false)
  created_at                                     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                                     DateTime  @default(now()) @db.Timestamptz(6)
  courses                                        courses   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lessons_lessons_chapter_idTochapters           lessons[] @relation("lessons_chapter_idTochapters")
  lessons_lessons_course_id_chapter_idTochapters lessons[] @relation("lessons_course_id_chapter_idTochapters")

  @@unique([course_id, id], map: "chapters_id_course_unique")
  @@unique([course_id, position], map: "chapters_position_unique")
  @@index([course_id, position], map: "idx_chapters_course_position")
}

model companies {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String               @unique @db.Citext
  name               String
  logo_url           String?
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  exercise_companies exercise_companies[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an index with non-default null sort order and requires additional setup for migrations. Visit https://pris.ly/d/default-index-null-ordering for more info.
model course_enrollments {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String            @db.Uuid
  course_id         String            @db.Uuid
  via_roadmap_id    String?           @db.Uuid
  status            enrollment_status @default(active)
  mode_override     progression_mode?
  completed_lessons Int               @default(0)
  progress_percent  Decimal           @default(0) @db.Decimal(5, 2)
  started_at        DateTime          @default(now()) @db.Timestamptz(6)
  completed_at      DateTime?         @db.Timestamptz(6)
  last_activity_at  DateTime?         @db.Timestamptz(6)
  courses           courses           @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roadmaps          roadmaps?         @relation(fields: [via_roadmap_id], references: [id], onUpdate: NoAction)

  @@unique([user_id, course_id])
  @@index([course_id], map: "idx_course_enrollments_course")
  @@index([user_id, last_activity_at(sort: Desc)], map: "idx_course_enrollments_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model course_outcomes {
  course_id String  @db.Uuid
  position  Int
  text      String
  courses   courses @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([course_id, position])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model course_reviews {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id  String   @db.Uuid
  user_id    String   @db.Uuid
  rating     Int      @db.SmallInt
  comment    String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  courses    courses  @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([course_id, user_id])
}

model course_technologies {
  course_id     String       @db.Uuid
  technology_id String       @db.Uuid
  courses       courses      @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  technologies  technologies @relation(fields: [technology_id], references: [id], onUpdate: NoAction)

  @@id([course_id, technology_id])
  @@index([technology_id], map: "idx_course_technologies_technology")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model courses {
  id                                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                               String                @unique @db.Citext
  title                              String
  description                        String?
  cover_image_url                    String?
  level                              current_level
  duration_hours                     Int?
  instructor_id                      String?               @db.Uuid
  prerequisite_note                  String?
  progression_mode                   progression_mode      @default(graph)
  status                             content_status        @default(draft)
  total_chapters                     Int                   @default(0)
  total_lessons                      Int                   @default(0)
  rating_avg                         Decimal?              @db.Decimal(3, 2)
  rating_count                       Int                   @default(0)
  enrollment_count                   Int                   @default(0)
  created_by                         String?               @db.Uuid
  published_at                       DateTime?             @db.Timestamptz(6)
  created_at                         DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                         DateTime              @default(now()) @db.Timestamptz(6)
  rejection_reason                   String?
  chapters                           chapters[]
  course_enrollments                 course_enrollments[]
  course_outcomes                    course_outcomes[]
  course_reviews                     course_reviews[]
  course_technologies                course_technologies[]
  users_courses_created_byTousers    users?                @relation("courses_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  users_courses_instructor_idTousers users?                @relation("courses_instructor_idTousers", fields: [instructor_id], references: [id], onUpdate: NoAction)
  roadmap_courses                    roadmap_courses[]
}

model exercise_companies {
  exercise_id String    @db.Uuid
  company_id  String    @db.Uuid
  companies   companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exercises   exercises @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([exercise_id, company_id])
  @@index([company_id], map: "idx_exercise_companies_company")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model exercise_progress {
  user_id         String                   @db.Uuid
  exercise_id     String                   @db.Uuid
  status          exercise_progress_status @default(todo)
  best_score      Int?
  attempt_count   Int                      @default(0)
  is_favorite     Boolean                  @default(false)
  first_solved_at DateTime?                @db.Timestamptz(6)
  last_attempt_at DateTime?                @db.Timestamptz(6)
  updated_at      DateTime                 @default(now()) @db.Timestamptz(6)
  exercises       exercises                @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users                    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, exercise_id])
  @@index([exercise_id], map: "idx_exercise_progress_exercise")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model exercise_set_enrollments {
  user_id                   String            @db.Uuid
  set_id                    String            @db.Uuid
  progression_mode_override progression_mode?
  started_at                DateTime          @default(now()) @db.Timestamptz(6)
  completed_at              DateTime?         @db.Timestamptz(6)
  exercise_sets             exercise_sets     @relation(fields: [set_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                     users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, set_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model exercise_set_items {
  set_id        String        @db.Uuid
  exercise_id   String        @db.Uuid
  position      Int
  exercises     exercises     @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exercise_sets exercise_sets @relation(fields: [set_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([set_id, exercise_id])
  @@unique([set_id, position], map: "exercise_set_items_position_unique")
}

model exercise_sets {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                     String                     @unique @db.Citext
  title                    String
  description              String?
  kind                     exercise_set_kind          @default(collection)
  progression_mode         progression_mode           @default(free)
  status                   content_status             @default(draft)
  created_by               String?                    @db.Uuid
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  exercise_set_enrollments exercise_set_enrollments[]
  exercise_set_items       exercise_set_items[]
  users                    users?                     @relation(fields: [created_by], references: [id], onUpdate: NoAction)
}

model exercise_tags {
  exercise_id String    @db.Uuid
  tag_id      String    @db.Uuid
  exercises   exercises @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags        tags      @relation(fields: [tag_id], references: [id], onUpdate: NoAction)

  @@id([exercise_id, tag_id])
  @@index([tag_id], map: "idx_exercise_tags_tag")
}

model exercise_technologies {
  exercise_id   String       @db.Uuid
  technology_id String       @db.Uuid
  exercises     exercises    @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  technologies  technologies @relation(fields: [technology_id], references: [id], onUpdate: NoAction)

  @@id([exercise_id, technology_id])
  @@index([technology_id], map: "idx_exercise_technologies_technology")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model exercises {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                  String                  @unique @db.Citext
  title                 String
  summary               String?
  kind                  exercise_kind           @default(code)
