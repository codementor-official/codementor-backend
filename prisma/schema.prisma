  study_groups          study_groups     @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  group_documents       group_documents? @relation(fields: [reference_document_id], references: [id], onUpdate: NoAction)

  @@unique([group_id, exercise_id])
  @@unique([group_id, id], map: "group_exercises_id_group_unique")
  @@index([group_id, due_at], map: "idx_group_exercises_group")
}

