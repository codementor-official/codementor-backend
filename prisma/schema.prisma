  other_exercises       exercises[]             @relation("exercisesToexercises")
  group_exercises       group_exercises[]
  lessons               lessons[]
  submissions           submissions[]
}

model group_activities {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id     String       @db.Uuid
  actor_id     String?      @db.Uuid
  action       String
  target_type  String?
  target_id    String?      @db.Uuid
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  users        users?       @relation(fields: [actor_id], references: [id], onUpdate: NoAction)
  study_groups study_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([group_id, created_at(sort: Desc)], map: "idx_group_activities_group")
}

