{
  "name": "codementor-backend",
  "version": "0.1.0",
  "description": "CodeMentor backend — service-based architecture with DDD bounded contexts",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build core-service",
    "lint": "eslint \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.json",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:sync": "npm run db:pull && npm run db:generate",
    "build:all": "nest build core-service && nest build learning-service && nest build exercise-service && nest build workspace-service && nest build document-service && nest build submission-service && nest build judge-service && nest build ai-service && nest build realtime-service",
    "start:core": "nest start core-service --watch",
    "start:learning": "nest start learning-service --watch",
    "start:exercise": "nest start exercise-service --watch",
    "start:workspace": "nest start workspace-service --watch",
    "start:document": "nest start document-service --watch",
    "start:submission": "nest start submission-service --watch",
    "start:judge": "nest start judge-service --watch",
    "start:ai": "nest start ai-service --watch",
    "start:realtime": "nest start realtime-service --watch"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.19.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "jwks-rsa": "^4.1.0",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.20.1",
    "nestjs-pino": "^4.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.2.0",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "prisma": "^6.19.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
