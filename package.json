{
  "name": "codementor-backend",
  "version": "0.1.0",
  "description": "CodeMentor backend — service-based architecture with DDD bounded contexts",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "seed:workspace-demo": "node --env-file=.env scripts/seed-workspace-demo.mjs",
    "seed:client-demo": "node --env-file=.env scripts/seed-client-demo.mjs",
    "migrate:client-support": "node --env-file=.env scripts/migrate-client-support.mjs",
    "migrate:notification-schema": "node --env-file=.env scripts/migrate-notification-schema.mjs",
    "verify:client-support": "node --env-file=.env scripts/verify-client-support.mjs",
    "migrate:workspace-content": "node --env-file=.env scripts/migrate-workspace-content.mjs",
    "migrate:workspace-ui": "node --env-file=.env scripts/migrate-workspace-ui.mjs",
    "build": "nest build core-service",
    "lint": "eslint \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.json",
    "smoke": "bash scripts/smoke.sh",
    "verify:progress-monotonic": "node --env-file=.env scripts/verify-lesson-progress-monotonic.mjs",
    "services": "node scripts/services.mjs",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:sync": "npm run db:pull && npm run db:generate",
    "build:all": "nest build core-service && nest build learning-service && nest build exercise-service && nest build workspace-service && nest build document-service && nest build submission-service && nest build ai-service && nest build realtime-service && nest build notification-service && nest build recommendation-service",
    "start:core": "nest start core-service --watch",
    "start:learning": "nest start learning-service --watch",
    "start:exercise": "nest start exercise-service --watch",
    "start:workspace": "nest start workspace-service --watch",
    "start:document": "nest start document-service --watch",
    "start:submission": "nest start submission-service --watch",
    "start:ai": "nest start ai-service --watch",
    "judge:install": "cd apps/judge-service && uv sync",
    "judge:images": "cd apps/judge-service && ./scripts/build-images.sh",
    "judge:dev": "cd apps/judge-service && uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 3007",
    "judge:start": "cd apps/judge-service && uv run uvicorn app.main:app --host 0.0.0.0 --port 3007",
    "judge:test": "cd apps/judge-service && uv run pytest",
    "judge:lint": "cd apps/judge-service && uv run ruff check .",
    "start:realtime": "nest start realtime-service --watch",
    "start:notification": "nest start notification-service --watch",
    "start:recommendation": "nest start recommendation-service --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.2.1",
    "@prisma/client": "^6.19.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "jwks-rsa": "^4.1.0",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.20.1",
    "nestjs-pino": "^4.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.2.0",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "prisma": "^6.19.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
