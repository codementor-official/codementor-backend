# Copy these values into your LOCAL .env. Never commit real credentials.
# This feature deliberately refuses mutations when NODE_ENV=production.
COMMERCE_MODE=mock
COMMERCE_JOBS_ENABLED=true
COMMERCE_CLIENT_URL=http://localhost:3000
# Public HTTPS tunnel to the LOCAL gateway, including /api/v1, for sandbox IPN.
COMMERCE_PUBLIC_API_URL=
COMMERCE_SANDBOX_REFUNDS=false
# Only true after verifying anonymous GET on private/course-videos/* is denied.
# No IAM/bucket policies are changed automatically by this feature.
COMMERCE_PRIVATE_MEDIA_READY=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Isolated local test DB only; never substitute the deployed application database.
COMMERCE_TEST_DATABASE_URL=postgresql://commerce_test@127.0.0.1:55439/commerce_test
